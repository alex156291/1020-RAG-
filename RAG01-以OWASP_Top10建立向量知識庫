= 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"display(pd\",\n  \"rows\": 6,\n  \"fields\": [\n    {\n      \"column\": \"\\u5957\\u4ef6\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 6,\n        \"samples\": [\n          \"torch\",\n          \"numpy\",\n          \"huggingface-hub\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"\\u7248\\u672c\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 6,\n        \"samples\": [\n          \"2.11.0+cu130\",\n          \"2.1.3\",\n          \"1.33.0\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","id":"d01edd8f","metadata":{"id":"d01edd8f"},"source":["## 3. 上傳教材 ZIP\n","\n","執行後選擇第一版教材 ZIP。程式只解開 TXT；README、CSV、問題集不會匯入知識庫。中文檔名由 Python 的 ZIP 工具讀取。\n","\n","每次執行這格會建立新的暫存資料夾，避免上一次的教材混進來。若上傳失敗，重新執行本格即可。後面的格子請重新依序執行。"]},{"cell_type":"code","execution_count":24,"id":"2274f6a2","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":297},"id":"2274f6a2","outputId":"3747350d-ee22-47e7-aa29-a3bf7ee0d487","executionInfo":{"status":"ok","timestamp":1793606206422,"user_tz":-480,"elapsed":6630,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-0935a33d-782e-4221-8e70-a6b2cfd2a2c0\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-0935a33d-782e-4221-8e70-a6b2cfd2a2c0\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving OWASP_Top10.zip to OWASP_Top10 (1).zip\n","教材： OWASP_Top10 (1).zip\n","TXT 數量： 10\n","• A01_存取控制失效.txt\n","• A02_安全設定錯誤.txt\n","• A03_軟體供應鏈失效.txt\n","• A04_密碼學機制失效.txt\n","• A05_注入攻擊.txt\n","• A06_不安全設計.txt\n","• A07_身分驗證失效.txt\n","• A08_軟體或資料完整性失效.txt\n","• A09_安全日誌與告警失效.txt\n","• A10_例外狀況處理不當.txt\n"]}],"source":["from google.colab import files\n","\n","uploaded = files.upload()\n","zip_names = [name for name in uploaded if name.lower().endswith(\".zip\")]\n","if len(zip_names) != 1:\n","    raise ValueError(\"請一次上傳一個教材 ZIP 檔。\")\n","\n","archive_name = zip_names[0]\n","archive_bytes = uploaded[archive_name]\n","SOURCE_ARCHIVE_SHA256 = hashlib.sha256(archive_bytes).hexdigest()\n","DATA_DIR = Path(tempfile.mkdtemp(prefix=\"rag_documents_\"))\n","\n","# 僅解開 TXT，並確保 ZIP 中的路徑不會寫到暫存資料夾外。\n","import io\n","with zipfile.ZipFile(io.BytesIO(archive_bytes)) as archive:\n","    members = [\n","        member for member in archive.infolist()\n","        if not member.is_dir()\n","        and member.filename.lower().endswith(\".txt\")\n","        and not any(part.startswith((\".\", \"__MACOSX\")) for part in Path(member.filename).parts)\n","    ]\n","    if not members:\n","        raise ValueError(\"ZIP 中找不到 TXT；請確認使用第一版教材，或準備自己的 TXT。\")\n","    destinations = set()\n","    for member in members:\n","        target = (DATA_DIR / member.filename).resolve()\n","        if not target.is_relative_to(DATA_DIR.resolve()):\n","            raise ValueError(f\"ZIP 包含不適當的檔案路徑：{member.filename}\")\n","        if target in destinations:\n","            raise ValueError(f\"ZIP 有重複檔名：{member.filename}\")\n","        destinations.add(target)\n","        target.parent.mkdir(parents=True, exist_ok=True)\n","        target.write_bytes(archive.read(member))\n","\n","txt_paths = sorted(DATA_DIR.rglob(\"*.txt\"), key=lambda p: p.relative_to(DATA_DIR).as_posix())\n","# 亦支援大寫 .TXT。\n","txt_paths = sorted(\n","    [p for p in DATA_DIR.rglob(\"*\") if p.is_file() and p.suffix.lower() == \".txt\"],\n","    key=lambda p: p.relative_to(DATA_DIR).as_posix(),\n",")\n","print(\"教材：\", archive_name)\n","print(\"TXT 數量：\", len(txt_paths))\n","for path in txt_paths:\n","    print(\"•\", path.relative_to(DATA_DIR).as_posix())\n","if EXPECTED_DOCUMENT_COUNT is not None and len(txt_paths) != EXPECTED_DOCUMENT_COUNT:\n","    print(f\"提醒：本次為 {len(txt_paths)} 篇，與原教材的 {EXPECTED_DOCUMENT_COUNT} 篇不同；仍可繼續。\")"]},{"cell_type":"markdown","id":"73c3761e","metadata":{"id":"73c3761e"},"source":["## 4. 先看一篇原始文件\n","\n","請觀察「標題」「來源網址」「教材整理日期」「【內容】」「【檢索練習問題】」等欄位。不是每個欄位都適合送進 embedding。\n","\n","本教材只取標題與正文。若把文件裡的練習問題也送進去，搜尋可能直接命中題目，無法公平觀察正文的檢索效果。\n","\n","可修改 `SAMPLE_INDEX`，換看其他文章。"]},{"cell_type":"code","execution_count":25,"id":"77776cc4","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"77776cc4","outputId":"f290d74f-e777-4758-903f-f03dc3db9f58","executionInfo":{"status":"ok","timestamp":1793606208840,"user_tz":-480,"elapsed":7,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["檔名： A01_存取控制失效.txt\n","==================================================\n","標題：存取控制失效（Broken Access Control）\n","資料類型：OWASP Top 10:2025 官方文件之繁體中文教學改寫摘要（非官方逐字翻譯）\n","分類編號：A01:2025\n","資料來源：OWASP Foundation（OWASP Top 10:2025）\n","來源網址：https://top10.owasp.org/2025/A01_2025-Broken_Access_Control/\n","教材整理日期：2026-11-02\n","\n","【內容】\n","存取控制用來限制使用者可查看、修改或刪除哪些資料，以及可執行哪些功能。當系統未在可信任的伺服器端正確驗證權限，使用者就可能越權存取其他人的資料或管理功能。\n","\n","【常見情境】\n","某訂單網站使用網址中的 order_id 查詢訂單，卻沒有確認訂單是否屬於目前登入者。使用者改變編號後，就可能看到其他人的訂單。這是典型的不安全直接物件參照（IDOR）情境。\n","\n","【防護方法】\n","1. 除公開資源外，預設拒絕存取，僅授權必要權限。\n","2. 在伺服器端對每次請求檢查身分、角色與資源擁有權。\n","3. 對敏感操作設計權限測試，記錄越權嘗試並視情況告警。\n","\n","【檢索練習問題】\n","1. 使用者能登入，為什麼還可能發生越權存取？\n","2. 什麼是 IDOR？\n","3. 如何防止一般使用者看到其他人的訂單？\n","\n","【提醒】\n","本文件供 RAG 教學與概念學習使用，係參考 OWASP Top 10:2025 整理的摘要，並非官方全文或滲透測試操作手冊。實際防護方案需視系統架構與威脅情境調整；細節與後續修訂應以原始網址為準。\n","\n"]}],"source":["SAMPLE_INDEX = 0\n","sample_path = txt_paths[SAMPLE_INDEX]\n","try:\n","    sample_raw = sample_path.read_text(encoding=\"utf-8-sig\")\n","except UnicodeDecodeError as exc:\n","    raise ValueError(f\"{sample_path.name} 不是可讀取的 UTF-8 文字。\") from exc\n","print(\"檔名：\", sample_path.name)\n","print(\"=\" * 50)\n","print(sample_raw)"]},{"cell_type":"markdown","id":"a08e408f","metadata":{"id":"a08e408f"},"source":["## 5. 第一個可修改函式：取出 RAG 文字\n","\n","`extract_rag_text(raw_text)` 回傳「標題＋【內容】正文」。找到【內容】後，讀到下一個【區段標題】為止；練習問題和提醒不會混入。\n","\n","**換自己的資料，主要修改這個函式。** 比如你的文件以 `正文：` 開始，就修改擷取規則。若找不到正文，本函式明確報錯，不擅自把整份文件拿去 embedding。\n","\n","這個回傳值會原樣保存；未來檢索後也將它交給 LLM，確保搜尋與回答使用同一份內容。"]},{"cell_type":"code","execution_count":26,"id":"ca9eb7e0","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ca9eb7e0","outputId":"56b074dc-7d42-4726-dfd7-60a92d8b5fa5","executionInfo":{"status":"ok","timestamp":1793606210742,"user_tz":-480,"elapsed":4,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["存取控制失效（Broken Access Control）\n","\n","存取控制用來限制使用者可查看、修改或刪除哪些資料，以及可執行哪些功能。當系統未在可信任的伺服器端正確驗證權限，使用者就可能越權存取其他人的資料或管理功能。\n","\n","擷取後字元數： 108\n"]}],"source":["def extract_rag_text(raw_text):\n","    \"\"\"從本教材 TXT 取出標題與正文；換資料時修改這裡。\"\"\"\n","    normalized = raw_text.lstrip(\"\\ufeff\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n","    title_match = re.search(r\"^標題[：:]\\s*(.+)$\", normalized, flags=re.MULTILINE)\n","    content_match = re.search(\n","        r\"^【內容】[ \\t]*\\n(?P<body>.*?)(?=^【[^】\\n]+】|\\Z)\",\n","        normalized,\n","        flags=re.MULTILINE | re.DOTALL,\n","    )\n","    if content_match is None or not content_match.group(\"body\").strip():\n","        raise ValueError(\"找不到非空的【內容】正文；請修改 extract_rag_text() 以配合文件格式。\")\n","    title = title_match.group(1).strip() if title_match else \"\"\n","    body = content_match.group(\"body\").strip()\n","    return f\"{title}\\n\\n{body}\" if title else body\n","\n","sample_rag_text = extract_rag_text(sample_raw)\n","print(sample_rag_text)\n","print(\"\\n擷取後字元數：\", len(sample_rag_text))"]},{"cell_type":"markdown","id":"04d3b092","metadata":{"id":"04d3b092"},"source":["## 6. 第二個可修改函式：取出 metadata\n","\n","`extract_metadata(raw_text, filename)` 回傳標題、網址、日期、檔名和文件性質。metadata 是追溯資料用的資訊，不會整包送進 embedding。\n","\n","**換自己的資料，可在這裡增減欄位。** 例如食譜可以增加料理類型，課程介紹可以增加學期。來源與日期找不到時用 `None`，不自行捏造；標題缺失時使用檔名。\n","\n","這裡的 `date` 是教材整理日期，不是法規生效日期。保留「教學改寫摘要」的性質，避免後續展示誤稱官方原文。"]},{"cell_type":"code","execution_count":27,"id":"eaffbd5d","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"eaffbd5d","outputId":"0ca859fc-979e-4a87-c922-dec7ffb5c2ff","executionInfo":{"status":"ok","timestamp":1793606212142,"user_tz":-480,"elapsed":4,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["{\n","  \"title\": \"存取控制失效（Broken Access Control）\",\n","  \"source_url\": \"https://top10.owasp.org/2025/A01_2025-Broken_Access_Control/\",\n","  \"date\": \"2026-11-02\",\n","  \"filename\": \"A01_存取控制失效.txt\",\n","  \"document_type\": \"OWASP Top 10:2025 官方文件之繁體中文教學改寫摘要（非官方逐字翻譯）\"\n","}\n"]}],"source":["def extract_metadata(raw_text, filename):\n","    \"\"\"取出本教材的描述資訊；換資料時修改這裡。\"\"\"\n","    normalized = raw_text.lstrip(\"\\ufeff\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n","    def read_field(name):\n","        match = re.search(rf\"^{re.escape(name)}[：:][ \\t]*(.*)$\", normalized, flags=re.MULTILINE)\n","        return match.group(1).strip() or None if match else None\n","\n","    return {\n","        \"title\": read_field(\"標題\") or Path(filename).stem,\n","        \"source_url\": read_field(\"來源網址\"),\n","        \"date\": read_field(\"教材整理日期\"),\n","        \"filename\": filename,\n","        \"document_type\": read_field(\"資料類型\") or \"未標示\",\n","    }\n","\n","sample_metadata = extract_metadata(sample_raw, sample_path.relative_to(DATA_DIR).as_posix())\n","print(json.dumps(sample_metadata, ensure_ascii=False, indent=2))"]},{"cell_type":"markdown","id":"f647fe1a","metadata":{"id":"f647fe1a"},"source":["## 7. 批次整理成統一格式\n","\n","把兩個函式組合起來，每篇得到 `doc_id`、`text` 和 `metadata`。檔案先排序，再按順序給編號；只要教材及排序不變，編號便相同。新增文件可能改變編號，因此需要整套重建索引與對照。\n","\n","請檢查列表中每篇是否有標題、正文及來源。缺少 metadata 會提醒；正文缺失則停止並指出檔名，讓你回到前兩格修改函式。"]},{"cell_type":"code","execution_count":28,"id":"2e5e4b10","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":584},"id":"2e5e4b10","outputId":"d3a86a80-51e3-4fdb-909e-bd63bdeca18d","executionInfo":{"status":"ok","timestamp":1793606213957,"user_tz":-480,"elapsed":24,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["    doc_id                                                 標題  正文含標題字元數  \\\n","0  doc_001                      存取控制失效（Broken Access Control）       108   \n","1  doc_002                  安全設定錯誤（Security Misconfiguration）       123   \n","2  doc_003            軟體供應鏈失效（Software Supply Chain Failures）       126   \n","3  doc_004                    密碼學機制失效（Cryptographic Failures）       130   \n","4  doc_005                                    注入攻擊（Injection）       120   \n","5  doc_006                             不安全設計（Insecure Design）       105   \n","6  doc_007                    身分驗證失效（Authentication Failures）       129   \n","7  doc_008    軟體或資料完整性失效（Software or Data Integrity Failures）       142   