? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"display(pd\",\n  \"rows\": 10,\n  \"fields\": [\n    {\n      \"column\": \"FAISS\\u7de8\\u865f\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 3,\n        \"min\": 0,\n        \"max\": 9,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          8,\n          1,\n          5\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"doc_id\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 10,\n        \"samples\": [\n          \"doc_009\",\n          \"doc_002\",\n          \"doc_006\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}],"source":["index = faiss.IndexFlatIP(DIMENSION)\n","index.add(embeddings)\n","documents_by_id = {doc[\"doc_id\"]: doc for doc in documents}\n","assert index.ntotal == len(index_doc_ids) == len(documents)\n","print(\"索引類型：\", type(index).__name__)\n","print(\"索引向量數：\", index.ntotal)\n","print(\"索引維度：\", index.d)\n","display(pd.DataFrame({\"FAISS編號\": range(len(index_doc_ids)), \"doc_id\": index_doc_ids}))"]},{"cell_type":"markdown","id":"4d0cbd38","metadata":{"id":"4d0cbd38"},"source":["## 12. 定義問題向量化與搜尋函式\n","\n","問題也要用同一個 embedding 模型向量化，但使用查詢專用前綴。`top_k` 表示取回幾篇文件；程式限制它不超過實際文件數。\n","\n","搜尋函式只做檢索，還沒有呼叫 LLM。精確搜尋保證依目前向量找到分數最高者，不保證文件一定足以回答問題。"]},{"cell_type":"code","execution_count":33,"id":"00b43286","metadata":{"id":"00b43286","executionInfo":{"status":"ok","timestamp":1793606239752,"user_tz":-480,"elapsed":3,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[],"source":["def embed_question(question):\n","    if not isinstance(question, str) or not question.strip():\n","        raise ValueError(\"請輸入非空白問題。\")\n","    query_input = QUERY_TEMPLATE.format(question=question.strip())\n","    if count_input_tokens(query_input) > TOKEN_LIMIT:\n","        raise ValueError(\"問題超過模型輸入長度上限，請縮短問題。\")\n","    query_vector = model.encode(\n","        [query_input], prompt=\"\", convert_to_numpy=True,\n","        normalize_embeddings=True, show_progress_bar=False,\n","    )\n","    query_vector = np.ascontiguousarray(query_vector, dtype=np.float32)\n","    if query_vector.shape != (1, DIMENSION) or not np.isfinite(query_vector).all():\n","        raise ValueError(\"問題向量的維度或數值不正確。\")\n","    if np.linalg.norm(query_vector) <= 0:\n","        raise ValueError(\"問題產生零向量。\")\n","    faiss.normalize_L2(query_vector)\n","    return query_vector\n","\n","\n","def search_documents(question, top_k=3):\n","    if isinstance(top_k, bool) or not isinstance(top_k, (int, np.integer)) or top_k < 1:\n","        raise ValueError(\"top_k 必須是大於0的整數。\")\n","    query_vector = embed_question(question)\n","    scores, positions = index.search(query_vector, min(int(top_k), index.ntotal))\n","    results = []\n","    for rank, (position, score) in enumerate(zip(positions[0], scores[0]), start=1):\n","        doc_id = index_doc_ids[int(position)]\n","        results.append({\"rank\": rank, \"score\": float(score), **documents_by_id[doc_id]})\n","    return results"]},{"cell_type":"markdown","id":"c1b9d71a","metadata":{"id":"c1b9d71a"},"source":["## 13. 試查一次，閱讀真正取回的內容\n","\n","修改 `QUESTION` 和 `TOP_K`，重新執行本格即可查詢。先看標題及分數，再讀完整正文，判斷是否有足夠依據。\n","\n","可以比較 `top_k=1`、`3`、`5`。也可問「政大附近哪家飲料店時薪最高？」：即使教材沒有答案，FAISS 仍會傳回最相近的文章。**相似度不是正確率，也不是模型有答案的機率。**"]},{"cell_type":"code","execution_count":34,"id":"463e102f","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":476},"id":"463e102f","outputId":"4e6dd052-58f9-4ea2-b37e-273a61c8ab1e","executionInfo":{"status":"ok","timestamp":1793606263869,"user_tz":-480,"elapsed":507,"user":{"displayName":"宗諺","userId":"16953460375844362090"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["   排名   doc_id                                               標題  \\\n","0   1  doc_005                                  注入攻擊（Injection）   \n","1   2  doc_002                安全設定錯誤（Security Misconfiguration）   \n","2   3  doc_008  軟體或資料完整性失效（Software or Data Integrity Failures）   \n","\n","   cosine_similarity                                                 來源  \n","0           0.844005   https://top10.owasp.org/2025/A05_2025-Injection/  \n","1           0.688022  https://top10.owasp.org/2025/A02_2025-Security...  \n","2           0.667509  https://top10.owasp.org/2025/A08_2025-Software...  "],"text/html":["\n","  <div id=\"df-88eaca19-a67c-43a3-add3-d384969c23fc\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>排名</th>\n","      <th>doc_id</th>\n","      <th>標題</th>\n","      <th>cosine_similarity</th>\n","      <th>來源</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>1</td>\n","      <td>doc_005</td>\n","      <td>注入攻擊（Injection）</td>\n","      <td>0.844005</td>\n","      <td>https://top10.o